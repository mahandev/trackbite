# Copy this file to ".env" and fill in your keys.
# Lines starting with "#" are comments. Do NOT wrap values in quotes.

# USDA FoodData Central — free, instant signup at:
#   https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# Optional. Edamam Food Database — free tier (10 req/min, 10k/month):
#   https://developer.edamam.com/edamam-food-and-shopping-apis
# Leave blank to disable Edamam fallback.
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

# Path to the Swift trackpad helper binary built by `make helper`.
# Default location works for the standard build.
TRACKWEIGHD_BIN=./trackweighd/bin/trackweighd

# Webcam index. 0 is the built-in FaceTime camera on most MacBooks.
CAMERA_INDEX=0

# SQLite cache file. Stores every successful lookup so we never re-hit the
# network for the same barcode twice. Safe to delete to clear the cache.
CACHE_DB=./trackbite.db
